{
  "name": "@tcbs/react-native-ondevice-ai",
  "version": "1.0.1",
  "description": "React Native on-device model management and multimodal Gemma LiteRT-LM inference",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "react-native": "src/index.ts",
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "src",
    "lib",
    "android/build.gradle",
    "android/src/main/AndroidManifest.xml",
    "android/src/main/java",
    "ios/LiteRTLM",
    "ios/vendor/CLiteRTLM.xcframework",
    "ios/TcbsGemmaModule.m",
    "ios/TcbsGemmaModule.swift",
    "react-native.config.js",
    "react-native-ondevice-ai.podspec",
    "AGENTS.md",
    "CLAUDE.md",
    "CONTRIBUTING.md",
    "llms.txt",
    "docs",
    "example",
    "README.md",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "keywords": [
    "react-native",
    "gemma",
    "litert",
    "model-management",
    "on-device",
    "llm"
  ],
  "license": "MIT",
  "homepage": "https://github.com/TechCraft-By-Subrata/react-native-ondevice-ai#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TechCraft-By-Subrata/react-native-ondevice-ai.git"
  },
  "bugs": {
    "url": "https://github.com/TechCraft-By-Subrata/react-native-ondevice-ai/issues"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run typecheck && npm run build && npm test && node scripts/verify-package.mjs",
    "prepack": "npm run verify"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.72"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
